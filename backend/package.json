{
  "name": "novara-backend",
  "version": "1.0.0",
  "description": "Session-based authentication backend for Novara",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "start:docker": "prisma generate && prisma migrate deploy && npm start",
    "books:download:gutenberg": "node scripts/downloadGutenbergBooks.js",
    "books:import:meta": "node scripts/importDownloadedBooksToDb.js",
    "books:map:genres": "node scripts/mapDownloadedBooksGenres.js",
    "books:sync:genres": "node scripts/syncMappedGenresToDb.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "3.11.174",
    "resend": "^4.8.0",
    "socket.io": "^4.8.3",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.2"
  }
}
