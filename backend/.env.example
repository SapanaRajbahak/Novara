# Core
PORT=5002
DATABASE_URL=postgresql://user:password@localhost:5432/novara
SESSION_SECRET=change-me
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=15m

# Resend / OTP verification
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
OTP_SECRET=change-me-to-a-long-random-secret
OTP_EMAIL_FROM=Novara <no-reply@readnovara.ca>

# OpenAI (chapter translation / writer AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Usage guard / anti-abuse
USAGE_DAILY_READ_LIMIT=5000
USAGE_READ_SPEED_LIMIT=60
USAGE_FAILED_REQUEST_LIMIT=20
USAGE_ACTIVE_HOURS_LIMIT=20
USAGE_THROTTLE_MINUTES=10

# Pro plan entitlements
PRO_REWARD_BOOST_MULTIPLIER=1.5
PRO_MONTHLY_DAILY_CHAPTER_LIMIT=100
PRO_YEARLY_DAILY_CHAPTER_LIMIT=150
PRO_MONTHLY_SIGNUP_BONUS_COINS=100
PRO_YEARLY_SIGNUP_BONUS_COINS=1200
